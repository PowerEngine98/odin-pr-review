{
  "name": "odin-pr-review",
  "displayName": "Odin PR Review",
  "description": "Review a pull request as a graph: files are vertices, call-site references are edges.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "odin",
  "repository": {
    "type": "git",
    "url": "https://github.com/PowerEngine98/odin-pr-review"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "pull request",
    "code review",
    "diff",
    "graph",
    "call hierarchy"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "odin.review",
        "title": "Review Pull Request as a Graph",
        "category": "Odin"
      },
      {
        "command": "odin.reviewAgainst",
        "title": "Review Against a Different Base…",
        "category": "Odin"
      },
      {
        "command": "odin.exportGraph",
        "title": "Export Change Graph as JSON",
        "category": "Odin"
      },
      {
        "command": "odin.reviewFromUri",
        "title": "Review Pull Request as a Graph (from link)",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.openFile",
        "title": "Open File",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.followEdge",
        "title": "Follow Reference",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.showGraph",
        "title": "Show the Graph",
        "category": "Odin",
        "icon": "$(graph)"
      },
      {
        "command": "odin.refresh",
        "title": "Refresh",
        "category": "Odin",
        "icon": "$(refresh)"
      },
      {
        "command": "odin.chooser",
        "title": "Choose Another Pull Request",
        "category": "Odin",
        "icon": "$(arrow-left)"
      },
      {
        "command": "odin.checkout",
        "title": "Check Out a Pull Request",
        "category": "Odin",
        "enablement": "false"
      }
    ],
    "configuration": {
      "title": "Odin PR Review",
      "properties": {
        "odin.baseRef": {
          "type": "string",
          "default": "",
          "description": "Branch a pull request is compared against. Leave empty to detect it from the remote's default branch. The diff is taken from the merge base, not the branch tip."
        },
        "odin.includeImports": {
          "type": "boolean",
          "default": true,
          "description": "Draw an edge for import statements as well as call sites."
        },
        "odin.includeContext": {
          "type": "boolean",
          "default": false,
          "description": "Resolve references on unchanged lines too. Shows pre-existing relationships, at the cost of a much busier graph."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "odin",
          "title": "Odin PR Review",
          "icon": "media/odin.svg"
        }
      ]
    },
    "views": {
      "odin": [
        {
          "id": "odin.changes",
          "name": "Change Graph",
          "type": "webview",
          "icon": "media/odin.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "odin.changes",
        "contents": "Review this branch as a graph: every changed file becomes a card, every call-site reference becomes an arrow.\n\n[Review Pull Request](command:odin.review)\n[Choose a base branch…](command:odin.reviewAgainst)\n\nThe diff is taken from the merge base, not the branch tip.",
        "when": "workspaceFolderCount != 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "odin.chooser",
          "when": "view == odin.changes && odin.hasGraph",
          "group": "navigation@0"
        },
        {
          "command": "odin.showGraph",
          "when": "view == odin.changes",
          "group": "navigation@1"
        },
        {
          "command": "odin.refresh",
          "when": "view == odin.changes",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "vsce package --no-dependencies --out ../../dist/odin-pr-review-0.1.0.vsix",
    "test:integration": "node integration/run.mjs"
  },
  "dependencies": {
    "@odin/core": "0.1.0",
    "@odin/highlight": "0.1.0",
    "@odin/resolver-kotlin": "0.1.0",
    "@odin/resolver-ts": "0.1.0",
    "@odin/webview": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Odin runs git and type-checks the workspace to resolve references between files."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Odin reads the repository with git, which needs files on disk."
    }
  }
}
