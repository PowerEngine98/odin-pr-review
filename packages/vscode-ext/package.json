{
  "name": "odin-pr-review",
  "displayName": "Odin PR Review",
  "description": "Review a pull request as a graph of the files it touches, with guided tours narrated by AI agents and agents you can pair with on the change.",
  "icon": "media/icon.png",
  "version": "0.4.0",
  "preview": true,
  "license": "MIT",
  "publisher": "powerengine98",
  "homepage": "https://github.com/PowerEngine98/odin-pr-review#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/PowerEngine98/odin-pr-review"
  },
  "bugs": {
    "url": "https://github.com/PowerEngine98/odin-pr-review/issues"
  },
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "pull request",
    "code review",
    "diff",
    "graph",
    "call hierarchy",
    "github",
    "ai",
    "agents",
    "guided tour"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:odin.graph",
    "onView:odin.changes",
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "odin.review",
        "title": "Review Pull Request as a Graph",
        "category": "Odin"
      },
      {
        "command": "odin.reviewAgainst",
        "title": "Review Against a Different Base…",
        "category": "Odin"
      },
      {
        "command": "odin.exportGraph",
        "title": "Export Change Graph as JSON",
        "category": "Odin"
      },
      {
        "command": "odin.reviewFromUri",
        "title": "Review Pull Request as a Graph (from link)",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.openFile",
        "title": "Open File",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.followEdge",
        "title": "Follow Reference",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.showGraph",
        "title": "Show the Graph",
        "category": "Odin",
        "icon": "$(graph)"
      },
      {
        "command": "odin.refresh",
        "title": "Refresh",
        "category": "Odin",
        "icon": "$(refresh)"
      },
      {
        "command": "odin.chooser",
        "title": "Choose Another Pull Request",
        "category": "Odin",
        "icon": "$(arrow-left)"
      },
      {
        "command": "odin.showChanges",
        "title": "Back to the Change List",
        "category": "Odin",
        "icon": "$(arrow-right)"
      },
      {
        "command": "odin.checkout",
        "title": "Check Out a Pull Request",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.readLocal",
        "title": "Review a Pull Request as It Is on This Machine",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.readOrigin",
        "title": "Review a Pull Request as the Forge Has It",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.readSince",
        "title": "Review What Changed Since My Last Review",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.chooseView",
        "title": "Choose What to Show: All, Since My Last Review, or Uncommitted",
        "category": "Odin",
        "icon": "$(history)"
      },
      {
        "command": "odin.checkoutLocal",
        "title": "Odin: Check Out This Change"
      },
      {
        "command": "odin.focusFile",
        "title": "Focus a File in the Graph",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.showTests",
        "title": "Show Test Files in the Graph",
        "category": "Odin",
        "enablement": "false"
      },
      {
        "command": "odin.hideSidebar",
        "title": "Hide the Side Bar",
        "category": "Odin",
        "icon": "$(layout-sidebar-left-off)"
      },
      {
        "command": "odin.showExplorer",
        "title": "Back to the File Explorer",
        "category": "Odin",
        "icon": "$(files)"
      },
      {
        "command": "odin.askForPulls",
        "title": "Ask the Forge for Pull Requests",
        "category": "Odin"
      },
      {
        "command": "odin.forgetConversation",
        "title": "Forget This Reading's Conversation",
        "category": "Odin"
      },
      {
        "command": "odin.openAtLine",
        "title": "Odin: Open File at This Line"
      },
      {
        "command": "odin.setUpKokoro",
        "title": "Set Up the Kokoro Narrator",
        "category": "Odin"
      },
      {
        "command": "odin.connectBrowser",
        "title": "Connect the Browser Extension",
        "category": "Odin"
      },
      {
        "command": "odin.disconnectBrowser",
        "title": "Disconnect the Browser Extension",
        "category": "Odin"
      }
    ],
    "configuration": {
      "title": "Odin PR Review",
      "properties": {
        "odin.baseRef": {
          "type": "string",
          "default": "",
          "description": "Branch a pull request is compared against. Leave empty to detect it from the remote's default branch. The diff is taken from the merge base, not the branch tip."
        },
        "odin.includeImports": {
          "type": "boolean",
          "default": true,
          "description": "Draw an edge for import statements as well as call sites."
        },
        "odin.includeContext": {
          "type": "boolean",
          "default": false,
          "description": "Resolve references on unchanged lines too. Shows pre-existing relationships, at the cost of a much busier graph."
        },
        "odin.liveReload": {
          "type": "boolean",
          "default": true,
          "description": "Keep a graph of the working tree in step with the working tree. Only applies to a local reading, where the change includes work that has not been committed. The whole project is watched, not only the files under review: renaming a function in an untouched file changes the references leaving the files that are."
        },
        "odin.kokoro.autoSetup": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Set up the Kokoro neural voice in the background when Odin starts. Off by default: setup downloads `uv`, a Python runtime and about 300 MB of voice model into Odin's storage. Run **Odin: Set Up the Kokoro Narrator** to set it up once on demand."
        },
        "odin.kokoro.voice": {
          "type": "string",
          "default": "af_heart",
          "description": "The Kokoro voice to read aloud with, such as af_heart, af_bella, am_michael or bf_emma."
        },
        "odin.kokoro.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "How fast the Kokoro narrator reads, where 1 is its natural pace."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "odin",
          "title": "Odin PR Review",
          "icon": "media/odin.svg"
        }
      ]
    },
    "views": {
      "odin": [
        {
          "id": "odin.changes",
          "name": "Change Graph",
          "type": "webview",
          "icon": "media/odin.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "odin.changes",
        "contents": "Review this branch as a graph: every changed file becomes a card, every call-site reference becomes an arrow.\n\n[Review Pull Request](command:odin.review)\n[Choose a base branch…](command:odin.reviewAgainst)\n\nThe diff is taken from the merge base, not the branch tip.",
        "when": "workspaceFolderCount != 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "odin.chooser",
          "when": "view == odin.changes && odin.hasGraph && !odin.onChooser",
          "group": "navigation@0"
        },
        {
          "command": "odin.showChanges",
          "when": "view == odin.changes && odin.hasGraph && odin.onChooser",
          "group": "navigation@0"
        },
        {
          "command": "odin.showExplorer",
          "when": "view == odin.changes && !odin.hasGraph",
          "group": "navigation@1"
        },
        {
          "command": "odin.hideSidebar",
          "when": "view == odin.changes",
          "group": "navigation@2"
        },
        {
          "command": "odin.refresh",
          "when": "view == odin.changes",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "odin.askForPulls",
          "when": "false"
        },
        {
          "command": "odin.openAtLine",
          "when": "false"
        },
        {
          "command": "odin.checkoutLocal",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "odin.openAtLine",
          "when": "webviewSection == 'line'"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "mkdir -p ../../dist && vsce package --no-dependencies --out ../../dist/odin-pr-review.vsix",
    "test:integration": "node integration/run.mjs"
  },
  "dependencies": {
    "@odin/core": "0.1.0",
    "@odin/highlight": "0.1.0",
    "@odin/resolver-kotlin": "0.1.0",
    "@odin/resolver-lang": "0.1.0",
    "@odin/resolver-ts": "0.1.0",
    "@odin/webview": "0.1.0",
    "mermaid": "^11"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Odin runs git and type-checks the workspace to resolve references between files."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Odin reads the repository with git, which needs files on disk."
    }
  }
}
